<resources>
    <style name="Theme.Inkly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_indigo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Inkly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Inkly</item>
    </style>
</resources>
