<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bornomala" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>

    <style name="Theme.Bornomala.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Bornomala</item>
    </style>
</resources>
