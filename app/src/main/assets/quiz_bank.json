{"questions":[{"q":"What is the output of `print(10 // 3)`?","code":"","options":["3.33","3","4","1"],"answer":1,"explain":"`//` is floor division."},{"q":"What is the output of `print(10 % 3)`?","code":"","options":["1","3","0","3.33"],"answer":0,"explain":"The remainder of 10 ÷ 3 is 1."},{"q":"Which function returns the number of items in a list?","code":"","options":["`count()`","`size()`","`len()`","`length()`"],"answer":2,"explain":"`len()` works on any collection."},{"q":"Which of these is a valid variable name?","code":"","options":["`1name`","`first-name`","`first_name`","`first name`"],"answer":2,"explain":"Use letters, digits and underscores, not starting with a digit."},{"q":"What does `type(\"5\")` return?","code":"","options":["int","str","float","bool"],"answer":1,"explain":"Anything in quotes is a string."},{"q":"What is `bool(\"\")`?","code":"","options":["True","False","None","Error"],"answer":1,"explain":"An empty string is falsy."},{"q":"Which keyword is used to define a function?","code":"","options":["`function`","`def`","`fun`","`define`"],"answer":1,"explain":"Python uses `def`."},{"q":"What does `[1, 2, 3][-1]` return?","code":"","options":["1","2","3","Error"],"answer":2,"explain":"Index -1 is the last item."},{"q":"Which collection is immutable?","code":"","options":["list","dict","set","tuple"],"answer":3,"explain":"Tuples can't be changed after creation."},{"q":"What does `\"abc\".upper()` return?","code":"","options":["`\"Abc\"`","`\"ABC\"`","`\"abc\"`","Error"],"answer":1,"explain":"upper() capitalizes every letter."},{"q":"What is printed?","code":"print(\"5\" + \"5\")\n","options":["5","55","10","Error"],"answer":1,"explain":"Adding strings concatenates them."},{"q":"What is printed?","code":"print(\"5\" + 5)\n","options":["TypeError","10","55","None"],"answer":0,"explain":"You can't add a str and an int."},{"q":"How do you start a comment?","code":"","options":["`//`","`<!--`","`#`","`%`"],"answer":2,"explain":"`#` starts a comment."},{"q":"What does `range(5)` produce?","code":"","options":["1 to 5","0 to 5","0 to 4","1 to 4"],"answer":2,"explain":"The stop value is excluded."},{"q":"Which loop is best when you know how many times to repeat?","code":"","options":["while","for","do-while","repeat"],"answer":1,"explain":"`for` with `range()` is ideal."},{"q":"What does `break` do inside a loop?","code":"","options":["Skips one iteration","Exits the loop","Restarts the loop","Pauses the program"],"answer":1,"explain":"break exits immediately."},{"q":"What does `continue` do?","code":"","options":["Exits the loop","Skips to the next iteration","Ends the program","Nothing"],"answer":1,"explain":"continue jumps to the next iteration."},{"q":"What is printed?","code":"nums = [1, 2, 3]\nnums.append(4)\nprint(nums)\n","options":["[1, 2, 3, 4]","[1, 2, 3, [4]]","[4, 1, 2, 3]","Error"],"answer":0,"explain":"append adds one item at the end."},{"q":"How do you get a value from a dict safely with a default?","code":"","options":["`d[key]`","`d.get(key, default)`","`d.find(key)`","`d.value(key)`"],"answer":1,"explain":"get() never raises KeyError."},{"q":"Which method removes and returns the last list item?","code":"","options":["`remove()`","`delete()`","`pop()`","`cut()`"],"answer":2,"explain":"pop() with no index removes the last item."},{"q":"What is `3 ** 2`?","code":"","options":["6","9","5","32"],"answer":1,"explain":"`**` is exponent."},{"q":"Which operator checks equality?","code":"","options":["`=`","`==`","`===`","`is`"],"answer":1,"explain":"`==` compares values."},{"q":"What does `\"py\" in \"python\"` return?","code":"","options":["True","False","\"py\"","Error"],"answer":0,"explain":"`in` checks for a substring."},{"q":"What is the result of `not True or False`?","code":"","options":["True","False","None","Error"],"answer":1,"explain":"`not True` is False; False or False is False."},{"q":"What does `input()` return?","code":"","options":["int","str","float","The user's type"],"answer":1,"explain":"Always a string."},{"q":"What is printed?","code":"print(\"Hello\", \"World\", sep=\"-\")\n","options":["Hello World","HelloWorld","Hello-World","Hello, World"],"answer":2,"explain":"sep sets the separator."},{"q":"Which statement handles exceptions?","code":"","options":["`if/else`","`try/except`","`catch/throw`","`check/error`"],"answer":1,"explain":"Python uses try/except."},{"q":"Which error happens with `[1, 2][5]`?","code":"","options":["KeyError","IndexError","ValueError","TypeError"],"answer":1,"explain":"The index is out of range."},{"q":"Which error happens with `{\"a\": 1}[\"b\"]`?","code":"","options":["KeyError","IndexError","NameError","None"],"answer":0,"explain":"The key doesn't exist."},{"q":"What does `len({1, 1, 2, 3})` return?","code":"","options":["4","3","2","Error"],"answer":1,"explain":"Sets remove duplicates."},{"q":"What is printed?","code":"print([x * 2 for x in range(3)])\n","options":["[0, 2, 4]","[2, 4, 6]","[0, 1, 2]","[1, 3, 5]"],"answer":0,"explain":"Each number is doubled."},{"q":"What does `\"a,b\".split(\",\")` return?","code":"","options":["`\"ab\"`","`[\"a\", \"b\"]`","`(\"a\", \"b\")`","`[\"a,b\"]`"],"answer":1,"explain":"split returns a list."},{"q":"What does `\" \".join([\"I\", \"love\", \"Python\"])` return?","code":"","options":["`\"ILovePython\"`","`\"I love Python\"`","`[\"I love Python\"]`","Error"],"answer":1,"explain":"join glues items with the separator."},{"q":"What is `round(2.567, 1)`?","code":"","options":["2.5","2.6","2.57","3"],"answer":1,"explain":"Rounded to one decimal place."},{"q":"What keyword returns a value from a function?","code":"","options":["`yield` only","`return`","`give`","`output`"],"answer":1,"explain":"return sends the value back."},{"q":"What is printed?","code":"def f():\n    x = 5\nprint(f())\n","options":["None","5","0","Error"],"answer":0,"explain":"A function without return gives None."},{"q":"What does `max([4, 9, 2])` return?","code":"","options":["4","9","2","15"],"answer":1,"explain":"max returns the largest item."},{"q":"What does `sorted([3, 1, 2])` return?","code":"","options":["`[3, 2, 1]`","`[1, 2, 3]`","`None`","`[1, 3, 2]`"],"answer":1,"explain":"sorted returns a new ascending list."},{"q":"What does `list.sort()` return?","code":"","options":["The sorted list","None","True","A copy"],"answer":1,"explain":"sort() sorts in place and returns None."},{"q":"Which keyword creates a class?","code":"","options":["`object`","`struct`","`class`","`new`"],"answer":2,"explain":"Use `class Name:`."},{"q":"What is `self` in a method?","code":"","options":["The class name","The current instance","A global variable","The parent"],"answer":1,"explain":"self refers to the object."},{"q":"Which method initializes a new object?","code":"","options":["`__new__`","`__init__`","`__start__`","`__main__`"],"answer":1,"explain":"__init__ sets up the object."},{"q":"How do you inherit from `Animal`?","code":"","options":["`class Dog extends Animal:`","`class Dog(Animal):`","`class Dog: Animal`","`class Dog inherits Animal:`"],"answer":1,"explain":"Put the parent in parentheses."},{"q":"What does `super()` give you?","code":"","options":["The child class","Access to the parent class","A new object","The module"],"answer":1,"explain":"It lets you call parent methods."},{"q":"Which module generates random numbers?","code":"","options":["`math`","`random`","`rand`","`numbers`"],"answer":1,"explain":"Use `import random`."},{"q":"What does `math.sqrt(81)` return?","code":"","options":["9","9.0","81","Error"],"answer":1,"explain":"sqrt returns a float."},{"q":"Which file mode appends to a file?","code":"","options":["`\"r\"`","`\"w\"`","`\"a\"`","`\"x\"`"],"answer":2,"explain":"a = append."},{"q":"Why use `with open(...)`?","code":"","options":["It's faster","It closes the file automatically","It encrypts","It's required"],"answer":1,"explain":"The context manager handles closing."},{"q":"Which module reads and writes JSON?","code":"","options":["`json`","`js`","`data`","`pickle`"],"answer":0,"explain":"`import json`."},{"q":"What does `yield` create?","code":"","options":["A class","A generator","A list","An error"],"answer":1,"explain":"Functions with yield are generators."},{"q":"What does a decorator do?","code":"","options":["Styles output","Wraps a function to add behaviour","Deletes a function","Creates a class"],"answer":1,"explain":"It returns a modified function."},{"q":"What is printed?","code":"for i in range(3):\n    print(i, end=\" \")\n","options":["0 1 2","1 2 3","0 1 2 3","1 2"],"answer":0,"explain":"range(3) gives 0, 1, 2."},{"q":"What is printed?","code":"n = 0\nwhile n < 3:\n    n += 1\nprint(n)\n","options":["2","3","4","Error"],"answer":1,"explain":"The while loop stops when n reaches 3."},{"q":"What does `\"Python\"[1:4]` return?","code":"","options":["`\"Pyt\"`","`\"yth\"`","`\"ytho\"`","`\"ython\"`"],"answer":1,"explain":"Characters at index 1, 2, 3."},{"q":"What does `abs(-8)` return?","code":"","options":["-8","8","0","Error"],"answer":1,"explain":"abs returns the absolute value."},{"q":"What is `int(\"42\") + 8`?","code":"","options":["`\"428\"`","50","Error","42"],"answer":1,"explain":"The string is converted to 42 first."},{"q":"Which value represents 'nothing' in Python?","code":"","options":["`null`","`nil`","`None`","`void`"],"answer":2,"explain":"Python uses None."},{"q":"How do you check if `x` is None?","code":"","options":["`x == None`","`x is None`","`x = None`","`None(x)`"],"answer":1,"explain":"Use `is` for None checks."},{"q":"What does `enumerate()` give you in a loop?","code":"","options":["Only values","Index and value","Only indexes","Keys"],"answer":1,"explain":"Pairs of (index, value)."},{"q":"What does `zip([1, 2], [\"a\", \"b\"])` pair up?","code":"","options":["`(1, 2), (\"a\", \"b\")`","`(1, \"a\"), (2, \"b\")`","`[1, 2, \"a\", \"b\"]`","Error"],"answer":1,"explain":"zip pairs items by position."},{"q":"Which is a dictionary comprehension?","code":"","options":["`[k: v for ...]`","`{k: v for k, v in pairs}`","`(k: v for ...)`","`dict[k for k]`"],"answer":1,"explain":"Curly braces with key: value."},{"q":"What does `x += 1` mean?","code":"","options":["x = 1","x = x + 1","x == x + 1","Error"],"answer":1,"explain":"Augmented assignment."},{"q":"What is printed?","code":"age = 18\nprint(\"adult\" if age >= 18 else \"minor\")\n","options":["adult","minor","18","Error"],"answer":0,"explain":"18 >= 18 is True."},{"q":"Which statement does nothing (a placeholder)?","code":"","options":["`skip`","`pass`","`null`","`empty`"],"answer":1,"explain":"`pass` is a no-op."},{"q":"What does `\"Hi\" * 3` give?","code":"","options":["`\"Hi3\"`","`\"HiHiHi\"`","Error","`[\"Hi\", \"Hi\", \"Hi\"]`"],"answer":1,"explain":"Strings can be repeated with *."},{"q":"What does `list(\"abc\")` give?","code":"","options":["`[\"abc\"]`","`[\"a\", \"b\", \"c\"]`","`(\"a\", \"b\", \"c\")`","Error"],"answer":1,"explain":"Each character becomes an item."},{"q":"What does `set([1, 2, 2, 3])` give?","code":"","options":["`{1, 2, 2, 3}`","`{1, 2, 3}`","`[1, 2, 3]`","Error"],"answer":1,"explain":"Duplicates are removed."},{"q":"What does `f\"{3.14159:.2f}\"` produce?","code":"","options":["`3.1`","`3.14`","`3.142`","`3`"],"answer":1,"explain":".2f = two decimal places."},{"q":"What does `@staticmethod` mean?","code":"","options":["The method gets `self`","The method gets `cls`","The method gets neither self nor cls","It runs once"],"answer":2,"explain":"It's a plain function inside the class."},{"q":"What does `lambda x: x + 1` create?","code":"","options":["A class","An anonymous function","A loop","A variable"],"answer":1,"explain":"lambda creates small functions."},{"q":"Which keyword imports only one name?","code":"","options":["`import math.sqrt`","`from math import sqrt`","`include sqrt`","`using math`"],"answer":1,"explain":"Use from … import …."},{"q":"What is printed?","code":"a = [1]\nb = a\nb.append(2)\nprint(a)\n","options":["[1, 2]","[2, 1]","[1]","Error"],"answer":0,"explain":"b points to the same list as a."},{"q":"What is `\"apple\" < \"banana\"`?","code":"","options":["True","False","Error","None"],"answer":0,"explain":"Strings compare alphabetically."},{"q":"Which keyword is used for pattern matching in Python 3.10+?","code":"","options":["`switch`","`match`","`case` only","`select`"],"answer":1,"explain":"match … case."},{"q":"What does `assert x > 0` do when x is -1?","code":"","options":["Nothing","Prints a warning","Raises AssertionError","Returns False"],"answer":2,"explain":"A failed assert raises AssertionError."},{"q":"What is `__name__` when a file is run directly?","code":"","options":["`\"main\"`","`\"__main__\"`","The file name","None"],"answer":1,"explain":"That's why `if __name__ == \"__main__\":` works."},{"q":"Which built-in reads a whole file as a string?","code":"","options":["`f.readlines()`","`f.read()`","`f.get()`","`f.text()`"],"answer":1,"explain":"read() returns all the text."},{"q":"What does `dict.items()` return?","code":"","options":["Keys only","Values only","Key-value pairs","The length"],"answer":2,"explain":"Use it to loop over key and value."},{"q":"What is printed?","code":"print(sum([1, 2, 3]))\n","options":["6","123","[1, 2, 3]","Error"],"answer":0,"explain":"sum adds the numbers."},{"q":"What is the correct file extension for Python files?","code":"","options":["`.pt`","`.py`","`.pyt`","`.python`"],"answer":1,"explain":"Python source files end in .py."}]}