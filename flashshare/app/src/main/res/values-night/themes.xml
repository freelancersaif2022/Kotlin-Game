<resources>
    <style name="Theme.FlashShare" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.FlashShare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.FlashShare</item>
    </style>
</resources>
