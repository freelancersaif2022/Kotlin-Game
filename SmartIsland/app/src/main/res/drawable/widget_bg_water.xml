<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF1E8FD8" android:endColor="#FF0B3A70" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="12dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFE5C48B" android:endColor="#FFC49A5C" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
