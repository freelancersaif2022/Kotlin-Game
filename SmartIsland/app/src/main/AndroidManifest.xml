<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rewarded ads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Silent mode and Focus toggles (user grants Do Not Disturb access in settings) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Haptics on island taps -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility for launcher apps, so the island can show the name and icon of the music
         or messaging app behind an event (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SmartIslandApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartIsland"
        tools:targetApi="35">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SmartIsland.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.IslandAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".island.IslandNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_w_lock"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.IslandTileService"
            android:exported="true"
            android:icon="@drawable/ic_w_island"
            android:label="@string/tile_island"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.DigitalClockWidget"
            android:exported="false"
            android:label="@string/widget_title_digital_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_digital_clock" />
        </receiver>

        <receiver
            android:name=".widget.AnalogClockWidget"
            android:exported="false"
            android:label="@string/widget_title_analog_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_analog_clock" />
        </receiver>

        <receiver
            android:name=".widget.BatteryRingWidget"
            android:exported="false"
            android:label="@string/widget_title_battery_ring">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_battery_ring" />
        </receiver>

        <receiver
            android:name=".widget.CalendarWidget"
            android:exported="false"
            android:label="@string/widget_title_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_calendar" />
        </receiver>

        <receiver
            android:name=".widget.PowerWidget"
            android:exported="false"
            android:label="@string/widget_title_power">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_power" />
        </receiver>

        <receiver
            android:name=".widget.VolumeWidget"
            android:exported="false"
            android:label="@string/widget_title_volume">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_volume" />
        </receiver>

        <receiver
            android:name=".widget.ChargingWidget"
            android:exported="false"
            android:label="@string/widget_title_charging">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_charging" />
        </receiver>

        <receiver
            android:name=".widget.WorldClockWidget"
            android:exported="false"
            android:label="@string/widget_title_world_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_world_clock" />
        </receiver>

        <receiver
            android:name=".widget.MediaWidget"
            android:exported="false"
            android:label="@string/widget_title_media">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_media" />
        </receiver>

        <receiver
            android:name=".widget.StopwatchWidget"
            android:exported="false"
            android:label="@string/widget_title_stopwatch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_stopwatch" />
        </receiver>

        <receiver
            android:name=".widget.SystemStatsWidget"
            android:exported="false"
            android:label="@string/widget_title_system_stats">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_system_stats" />
        </receiver>

        <receiver
            android:name=".widget.QuickTogglesWidget"
            android:exported="false"
            android:label="@string/widget_title_quick_toggles">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_quick_toggles" />
        </receiver>

    </application>
</manifest>
