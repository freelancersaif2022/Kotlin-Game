; Engine configuration file.
; Cyberpunk Arena - Godot 4.4 third-person Android action game.

config_version=5

[application]

config/name="Cyberpunk Arena"
config/description="Third-person 3D action arena featuring the Cyberpunk Warrior."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.93, 0.945, 0.96, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/core/game_input.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

